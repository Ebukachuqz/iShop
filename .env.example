# iShop (Drake) - Environment Configuration Example
# Copy this file to .env and supply actual values for your local or development deployment.
# NEVER commit real credentials or private keys into source control.

# =============================================================================
# Shopify App & Storefront Configuration
# =============================================================================
SHOPIFY_APP_CLIENT_ID=your_shopify_app_client_id
SHOPIFY_APP_CLIENT_SECRET=your_shopify_app_client_secret
SHOPIFY_APP_URL=https://localhost:3000
SHOPIFY_SCOPES=read_products,read_cart,write_cart
SHOPIFY_STOREFRONT_API_VERSION=2026-07
# Allowed shop domains and origins (comma-separated)
ALLOWED_SHOP_DOMAINS=example-store.myshopify.com
ALLOWED_ORIGINS=https://example-store.myshopify.com

# =============================================================================
# Drake Runtime Service (FastAPI / Pipecat)
# =============================================================================
RUNTIME_HOST=127.0.0.1
RUNTIME_PORT=8000
RUNTIME_URL=http://127.0.0.1:8000
RUNTIME_WSS_URL=ws://127.0.0.1:8000/ws
# Service-owned persistent SQLite storage paths (git-ignored)
RUNTIME_DATABASE_PATH=services/runtime/data/ishop_runtime.sqlite
SHOPIFY_APP_DATABASE_PATH=apps/shopify/data/ishop_shopify.sqlite

# Session & Grant Security
# Secret key used to sign and verify short-lived shopper session grants (minimum 32 random chars)
SESSION_SIGNING_SECRET=replace_with_a_secure_random_signing_secret_min_32_chars
SESSION_TTL_SECONDS=1800

# =============================================================================
# Merchant & Active Profile Selection (Server-side IDs)
# =============================================================================
# Enabled profile IDs (must match approved registry entries in CONFIGURATION.md)
DEFAULT_ASR_PROFILE=sahara-stream-pcm
DEFAULT_LLM_PROFILE=gemini-3.8-flash
DEFAULT_TTS_PROFILE=sahara-tts-female-pcm

# =============================================================================
# Speech Recognition & Synthesis Provider Credentials (Server-side only)
# =============================================================================
# Intron / Sahara Voice API (Primary competition route)
SAHARA_API_TOKEN=your_intron_sahara_bearer_token
SAHARA_API_KEY=your_intron_sahara_bearer_token
SAHARA_TRANSCRIBE_URL=https://infer.voice.intron.io/file/v1/upload/sync
SAHARA_LANGUAGE_CODE=pcm
SAHARA_STT_WS_URL=wss://infer.voice.intron.io/stt/v1/stream
SAHARA_TTS_WS_URL=wss://infer.voice.intron.io/tts/v1/stream

# Groq Whisper Large v3 and AssemblyAI (Benchmark competitors)
GROQ_API_KEY=your_groq_api_key
ASSEMBLYAI_API_KEY=your_assemblyai_api_key

# ElevenLabs (Benchmark competitor)
ELEVENLABS_API_KEY=your_elevenlabs_api_key


# =============================================================================
# LLM Providers (Independent & Configurable)
# =============================================================================
# Google Gemini Developer API (Eligible for free tier development)
GEMINI_API_KEY=your_gemini_api_key

# The Groq credential can also enable the optional Groq LLM profile.

# =============================================================================
# Research, Logging & Safety Boundaries
# =============================================================================
# Audio recording is disabled by default for shopper privacy
RECORD_AUDIO_ENABLED=false
# Local storage path for private consented audio fixtures (git-ignored)
RESEARCH_DATA_PATH=data/private/
# Operational log retention days
LOG_RETENTION_DAYS=7
