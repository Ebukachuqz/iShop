{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ishop.internal/schemas/v1/turn_decision.json",
  "title": "TurnDecision",
  "description": "Conversation-first top-level decision (respond, clarify, or act).",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["respond", "clarify", "act"]
    },
    "response_text": {
      "type": ["string", "null"]
    },
    "response_purpose": {
      "type": ["string", "null"],
      "enum": [
        "greeting",
        "capability_help",
        "general_assistance",
        "refusal",
        "store_info",
        "informational",
        null
      ]
    },
    "clarification_question": {
      "type": ["string", "null"]
    },
    "clarification_options": {
      "type": "array",
      "items": { "type": "string" }
    },
    "clarification_fields": {
      "type": "array",
      "items": { "type": "string" }
    },
    "intent": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "shopping_intent.json"}
      ]
    },
    "target_reference": {
      "$ref": "shopping_intent.json#/properties/target_reference"
    },
    "grounded_facts": {
      "type": "array",
      "items": { "type": "object" }
    }
  },
  "required": ["mode"],
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "respond"}}},
      "then": {"required": ["response_text", "response_purpose"], "properties": {"response_text": {"type": "string", "minLength": 1}}}
    },
    {
      "if": {"properties": {"mode": {"const": "clarify"}}},
      "then": {"required": ["clarification_question"], "properties": {"clarification_question": {"type": "string", "minLength": 1}}}
    },
    {
      "if": {"properties": {"mode": {"const": "act"}}},
      "then": {"required": ["intent"], "properties": {"intent": {"$ref": "shopping_intent.json"}}}
    }
  ],
  "additionalProperties": false
}
