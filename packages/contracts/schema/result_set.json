{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ishop.internal/schemas/v1/result_set.json",
  "title": "ImmutableResultSet",
  "type": "object",
  "properties": {
    "result_set_id": {"type": "string", "pattern": "^rs_"},
    "query": {"type": ["string", "null"]},
    "product_ids": {"type": "array", "items": {"type": "string"}, "maxItems": 20},
    "observed_at_ms": {"type": "integer", "minimum": 1},
    "shop_id": {"type": "string"},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
    ,"entries": {"type": "array", "maxItems": 20, "items": {"type": "object"}}
    ,"rank_reason": {"type": "string"}
    ,"coverage": {"type": "string"}
    ,"presented": {"type": "boolean"}
    ,"constraints": {"type": "object"}
  },
  "required": ["result_set_id", "product_ids", "observed_at_ms", "shop_id", "currency"],
  "additionalProperties": false
}
