<div
  id="ishop-drake-root"
  data-bootstrap-url="{{ routes.root_url }}apps/ishop/bootstrap"
  data-shop-domain="{{ shop.permanent_domain | escape }}"
  data-bootstrap-script-url="{{ 'drake-bootstrap.js' | asset_url }}"
  data-widget-script-url="{{ 'drake-widget.js' | asset_url }}"
  data-bridge-script-url="{{ 'drake-bridge.js' | asset_url }}"
  data-catalog-script-url="{{ 'drake-catalog.js' | asset_url }}"
  data-voice-ws-url="{{ block.settings.voice_ws_url | escape }}"
  hidden
></div>

{% schema %}
{
  "name": "Drake voice shopping",
  "target": "body",
  "javascript": "drake-voice.js",
  "stylesheet": "drake-bootstrap.css",
  "settings": [
    {
      "type": "text",
      "id": "voice_ws_url",
      "label": "Voice runtime WebSocket URL",
      "info": "Use the WSS base URL supplied by the iShop deployment. Replace the placeholder before testing voice.",
      "default": "wss://ishop.invalid/ws"
    }
  ]
}
{% endschema %}
